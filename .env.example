############################################################
# llama-cag-n8n configuration
#
# Don't edit this file — run `python llamacag.py setup` to
# create a .env with the three secrets generated for you.
############################################################

########## Model ##########

# Any GGUF on Hugging Face, "<user>/<repo>[:quant]". Downloaded once at first
# boot into the llama_models Docker volume, then runs offline.
# The default is Google's official quantization-aware-trained build of
# Gemma 4 12B (6.5 GB, 262k context, Apache 2.0).
#
# Alternatives (mid-2026), by hardware budget:
#   google/gemma-4-E4B-it-qat-q4_0-gguf           lighter, for ~8 GB machines
#   unsloth/Qwen3.5-9B-GGUF:Q4_K_M                strong small dense model
#   google/gemma-4-26B-A4B-it-qat-q4_0-gguf       MoE: 26B quality, ~4B active
#                                                 speed; wants ~20 GB free RAM
#   ggml-org/GLM-4.7-Flash-GGUF:Q4_K              big-workstation class, 200k ctx
LLAMA_MODEL=google/gemma-4-12B-it-qat-q4_0-gguf

# Total context window in tokens. Split evenly across CAG_SLOTS; each slot
# must fit one document + answer head-room. KV memory scales with this, but
# q8_0 KV quantization (below) halves it. Gemma 4 supports up to 262144.
LLAMA_CTX_SIZE=65536

# How many documents stay "hot" (KV state resident in RAM) simultaneously.
# Switching between hot documents costs nothing; a cold document is restored
# from disk. Raise to 2-4 if you alternate between documents and have RAM —
# but remember each slot only gets LLAMA_CTX_SIZE / CAG_SLOTS tokens.
# Slots parallelize residency, not generation: inference is serialized, so a
# long warm on one slot delays queries on the others (ingest big docs off-peak).
CAG_SLOTS=1

# KV cache precision: q8_0 halves context memory at negligible quality cost.
# Set to f16 for full precision.
LLAMA_CACHE_TYPE_KV=q8_0

# CPU threads for inference. -1 = auto-detect.
LLAMA_THREADS=-1

# Extra llama-server flags, appended verbatim. Example:
#   LLAMA_EXTRA_ARGS=--cache-reuse 256
LLAMA_EXTRA_ARGS=

# Stack-wide answer defaults (each /query request may still override them).
# Chatbot mode: DEFAULT_TEMPERATURE=0.0 gives deterministic, extractive answers
# — same question, same answer. 0.2 (default) = grounded but natural phrasing.
#DEFAULT_TEMPERATURE=0.2
#DEFAULT_MAX_ANSWER_TOKENS=1024

# Server-side cap for POST /documents uploads, in megabytes (mirrors the MCP
# client's 50 MB guard).
#MAX_UPLOAD_MB=50

# POST /verify grounds a returned quote against the source: the minimum difflib
# ratio (0..1) at which a non-exact quote still counts as grounded. Higher =
# stricter (catches more fabrications, but flags more honest paraphrases).
#QUOTE_MATCH_THRESHOLD=0.9

# All-in-Docker mode runs the llama-server container (default). For NATIVE mode
# (llama-server on the host — required for Metal on Apple Silicon, see
# docs/HARDWARE.md) set COMPOSE_PROFILES empty and uncomment LLAMA_SERVER_URL:
COMPOSE_PROFILES=local-llama
#LLAMA_SERVER_URL=http://host.docker.internal:8080

# Uncomment to pin different images. The rolling `:server` tag is fine for
# tinkering; for a deployment, pin a build-numbered tag and upgrade deliberately
# (browse tags at https://github.com/ggml-org/llama.cpp/pkgs/container/llama.cpp).
#LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
#LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9859   # known-good pin (verified 2026-07-03)
#LLAMA_IMAGE_CUDA=ghcr.io/ggml-org/llama.cpp:server-cuda
#LLAMA_IMAGE_VULKAN=ghcr.io/ggml-org/llama.cpp:server-vulkan
#LLAMA_GPU_LAYERS=999
#N8N_VERSION=latest

########## Secrets — generated by `python llamacag.py setup` ##########

DB_PASSWORD=CHANGE_ME
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME

########## Paths ##########

# Host folder watched for new documents (relative to this directory is fine).
DOCUMENTS_FOLDER=./documents

########## Ports (all bound to 127.0.0.1) ##########

N8N_PORT=5678
CAG_API_PORT=8000
LLAMA_PORT=8080
DB_PORT=5432

########## Misc ##########

# Used by n8n for schedule triggers (e.g. Europe/Paris).
GENERIC_TIMEZONE=UTC

# Database identity (defaults are fine; password above is what matters).
DB_NAME=llamacag
DB_USER=llamacag
