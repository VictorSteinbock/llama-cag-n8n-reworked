{
  "name": "CAG Maintenance",
  "nodes": [
    {
      "parameters": {
        "content": "## CAG Maintenance\n\nRuns nightly at 03:00 (`GENERIC_TIMEZONE`).\n\ncag-api reconciles disk with the database: orphaned KV cache files are deleted, documents whose cache file went missing are reported (they self-heal on their next query), and cache disk usage is measured.\n\nThe report lands in this workflow's execution log — nothing else to configure.",
        "height": 280,
        "width": 400
      },
      "id": "c3d62e30-0000-4000-8000-000000000001",
      "name": "What this does",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-260, -180]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "c3d62e30-0000-4000-8000-000000000002",
      "name": "Nightly at 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cag-api:8000/maintenance",
        "options": {
          "timeout": 300000
        }
      },
      "id": "c3d62e30-0000-4000-8000-000000000003",
      "name": "Run Maintenance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    }
  ],
  "connections": {
