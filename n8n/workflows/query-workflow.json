{
  "name": "CAG Query",
  "nodes": [
    {
      "parameters": {
        "content": "## CAG Query\n\nPOST to this webhook to ask a question against your cached documents:\n\n```\ncurl -X POST http://localhost:5678/webhook/cag/query \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"question\": \"Summarize the key points\"}'\n```\n\nOptional body fields: `document_id`, `max_tokens`, `temperature`.\nWithout `document_id` the most recently cached document is used.\n\nNo credentials needed — cag-api does all the work.",
        "height": 320,
        "width": 420
      },
      "id": "9a1f0a10-0000-4000-8000-000000000001",
      "name": "How to use",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-280, -180]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cag/query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9a1f0a10-0000-4000-8000-000000000002",
      "name": "Query Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 0],
      "webhookId": "3f7f4b7e-9c2a-4a8e-b9d0-1a2b3c4d5e6f"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cag-api:8000/query",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: $json.body.question, document_id: $json.body.document_id, max_tokens: $json.body.max_tokens, temperature: $json.body.temperature }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "9a1f0a10-0000-4000-8000-000000000003",
      "name": "Ask CAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "9a1f0a10-0000-4000-8000-000000000004",
      "name": "Respond With Answer",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.error?.message ?? $json.error ?? 'CAG API request failed' }) }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "9a1f0a10-0000-4000-8000-000000000005",
      "name": "Respond With Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 120]
    }
  ],
  "connections": {
    "Query Webhook": {
      "main": [
        [
          {
            "node": "Ask CAG API",
